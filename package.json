{
  "name": "api-usage-monitor",
  "description": "Tracks API usage and cost via poller snapshots, pushed telemetry, and OTLP metrics. Production: usage.jays.services",
  "homepage": "https://usage.jays.services",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "repair:claude-cost": "node scripts/repair-claude-cumulative-cost.mjs",
    "pricing:update": "node scripts/update-model-pricing.mjs",
    "pricing:audit": "node scripts/audit-model-pricing.mjs",
    "repair:anthropic-funding": "node scripts/repair-anthropic-funding.mjs",
    "add:cursor-subscription": "node scripts/add-cursor-subscription.mjs",
    "antigravity:collect": "node scripts/antigravity-usage-collector.mjs",
    "antigravity-session:collect": "node scripts/antigravity-session-collector.mjs",
    "fleet:collect": "node scripts/fleet-usage-collector.mjs",
    "codex:collect": "node scripts/codex-usage-collector.mjs",
    "grok:collect": "node scripts/grok-usage-collector.mjs",
    "subscription-quota:collect": "node scripts/subscription-quota-collector.mjs",
    "copilot:collect": "node scripts/copilot-usage-collector.mjs",
    "deepseek:collect": "node scripts/deepseek-usage-collector.mjs",
    "minimax:collect": "node scripts/minimax-usage-collector.mjs",
    "import:receipt-screenshots": "node scripts/add-user-billing-receipts.mjs",
    "import:billing-receipts": "node scripts/import-private-billing-receipts.mjs",
    "receipt-inbox:verify-lifecycle": "node scripts/verify-receipt-inbox-lifecycle.mjs",
    "receipt-inbox:deploy-auditor": "npm run receipt-inbox:verify-lifecycle && wrangler deploy --config workers/receipt-lifecycle-auditor/wrangler.jsonc",
    "receipt-inbox:deploy": "npm run receipt-inbox:deploy-auditor && wrangler deploy --config workers/receipt-inbox/wrangler.jsonc",
    "receipt-inbox:rules": "wrangler email routing rules list jays.services",
    "import:subscription-adjustments": "node scripts/import-manual-subscription-events.mjs",
    "audit:subscription-currency": "node scripts/audit-subscription-currency.mjs",
    "migrate:provider-secrets": "node scripts/migrate-provider-config-secrets.mjs",
    "audit:provider-duplicates": "node scripts/audit-provider-duplicates.mjs",
    "audit:subscription-links": "node scripts/audit-subscription-links.mjs",
    "ensure:subscription-link-index": "node scripts/ensure-subscription-link-unique-index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:receipt-inbox-worker": "vitest run --config workers/receipt-inbox/vitest.config.mjs",
    "test:migrate-safe": "node scripts/test-migrate-safe-repro.mjs",
    "test:sqlite-backup": "node scripts/test-sqlite-pre-migration-backup.mjs",
    "test:r2-archive": "node scripts/test-r2-weekly-archive.mjs",
    "test:startup-config": "node scripts/test-startup-config.mjs",
    "test:oracle-deploy": "node scripts/test-oracle-deploy-config.mjs",
    "test:apple-projects": "bash scripts/verify-apple-projects.sh",
    "test:antigravity-collector": "node scripts/test-antigravity-collector.mjs",
    "test:session-token-collectors": "node scripts/test-session-token-collectors.mjs",
    "test:collector-runtime": "node scripts/test-local-collector-runtime.mjs",
    "test:cf-token-map": "bash scripts/test-cf-token-map.sh",
    "test:replica-status-probe": "bash scripts/test-replica-status-probe.sh",
    "test:sentry-ci-report": "python3 scripts/test-sentry-ci-report.py",
    "verify": "npm run test:sentry-ci-report && npm run lint && npm run typecheck && npm test && npm run test:receipt-inbox-worker && npm run test:migrate-safe && npm run test:sqlite-backup && npm run test:r2-archive && npm run test:startup-config && npm run test:oracle-deploy && npm run test:apple-projects && npm run test:antigravity-collector && npm run test:session-token-collectors && npm run test:collector-runtime && npm run test:cf-token-map && npm run test:replica-status-probe && npm run build"
  },
  "dependencies": {
    "@datadog/browser-logs": "^7.15.0",
    "@datadog/browser-rum": "^7.9.0",
    "@jaywedgeworth22/congress-trading-shared": "github:Simple-With-Us/congress-trading-shared#semver:^2.7.1",
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^11.1.0",
    "dd-trace": "^6.17.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "postal-mime": "^4.0.0",
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.2",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.18",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "minimatch": "^10.0.3",
    "postcss": "^8.5.18",
    "sharp": "0.35.4",
    "undici": "^7.29.1",
    "js-yaml": "^5.4.1",
    "deepmerge-ts": "^8.0.0",
    "brace-expansion": "^5.0.12"
  }
}
