# Environment Variables
# Copy this file to .env and fill in your values
#
# LOCAL DEVELOPMENT ONLY. Production runtime config (secrets AND non-secrets)
# lives in the Infisical `usage-monitor` project (env prod, path /) and is
# synced to tmpfs on the Oracle host by deploy/oracle/infisical-env-sync.sh —
# see DEPLOY.md "Runtime env: Infisical is the source of truth". Do not add
# production values here, and do not change local dev semantics below.

DATABASE_URL="file:./dev.db"

# SQLite native-memory bounds. The server uses one connection, a ~2MiB page
# cache, disabled mmap, and disk-backed temporary B-trees by default. The
# latter keeps large current-month GROUP BY operations out of the 512MiB
# process RSS; use MEMORY only after measuring sufficient headroom.
# SQLITE_CACHE_SIZE_KIB="2000"
# SQLITE_MMAP_SIZE_BYTES="0"
# SQLITE_TEMP_STORE="file" # file | memory

# Number of verified transaction-consistent snapshots retained beside an
# existing SQLite database before startup schema synchronization (1-10).
# SQLITE_PRE_MIGRATION_BACKUP_RETENTION="3"

# Encryption key for stored API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="change-me-to-a-random-64-char-hex-string"
# Optional separate HMAC key for provider-reported opaque key identifiers.
# Falls back to ENCRYPTION_KEY with domain separation. Keep stable across deploys.
ATTRIBUTION_IDENTITY_HMAC_KEY=""
# Optional comma-separated prior keys retained during rotation; current key stays first above.
ATTRIBUTION_IDENTITY_HMAC_PREVIOUS_KEYS=""

# Cron secret to protect the fetch-all endpoint
CRON_SECRET="change-me-to-a-random-secret"

# Bearer token accepted by POST /api/ingest/usage for sibling app telemetry
USAGE_INGEST_TOKEN="change-me-to-a-random-secret"

# Dedicated receipt-import credentials. Keep the ingest token distinct from
# USAGE_INGEST_TOKEN. Keep the identity key stable across signing-key rotation;
# both keys must be at least 32 characters.
BILLING_RECEIPT_INGEST_TOKEN="change-me-to-a-distinct-random-secret"
BILLING_RECEIPT_IDENTITY_KEY="change-me-to-a-stable-32-character-identity-secret"
BILLING_RECEIPT_HMAC_KEY="change-me-to-a-distinct-32-character-signing-secret"

# Optional private Cloudflare Email Routing/R2 quarantine summary. This token
# is read-only and must not equal any usage or billing-receipt ingest secret.
# RECEIPT_INBOX_READ_TOKEN="change-me-to-a-distinct-32-character-read-secret"
# Optional evidence token for dashboard download/ignore. Never send this to
# the browser. Must differ from RECEIPT_INBOX_READ_TOKEN and all ingest tokens.
# RECEIPT_INBOX_EVIDENCE_TOKEN="change-me-to-a-distinct-32-character-evidence-secret"
# Unlisted Apple Calendar subscribe token for GET /api/bills.ics?token=...
# BILLS_CALENDAR_TOKEN="change-me-to-a-distinct-32-character-calendar-secret"
# Machine token for scripts/file-owner-receipt-expenses.mjs (not the Email Worker).
# OWNER_EXPENSE_TOKEN="change-me-to-a-distinct-32-character-expense-secret"

# Optional local-only receipt importer credentials. The server never reads
# these names; mirror the local token/signing key into its canonical receipt
# env vars when launching a local server (see the rollout guide).
# BILLING_RECEIPT_LOCAL_INGEST_TOKEN="change-me-to-a-local-random-secret"
# BILLING_RECEIPT_LOCAL_IDENTITY_KEY="change-me-to-a-local-stable-identity-secret"
# BILLING_RECEIPT_LOCAL_HMAC_KEY="change-me-to-a-local-signing-secret"

# Optional: dedicated read-only token for GET /api/budget-status.
# Falls back to USAGE_INGEST_TOKEN when unset.
# USAGE_READ_TOKEN="change-me-to-another-random-secret"
# In production, USAGE_READ_TOKEN is required for /api/budget-status and
# GET /api/subscriptions (no silent fallback to USAGE_INGEST_TOKEN). Set
# USAGE_READ_TOKEN_ALLOW_INGEST_FALLBACK=true only for emergency break-glass.
# USAGE_READ_TOKEN_ALLOW_INGEST_FALLBACK="false"
# Optional Litestream replica side-channel for /api/ready backup truth (C4):
# LITESTREAM_REPLICA_STATUS_PATH="/data/litestream-replica-status.json"
# LITESTREAM_REPLICA_MAX_AGE_SECONDS="10800"

# Optional: Hetzner + Coolify host metrics for GET /api/server-metrics
# (iOS Client Monitor Settings → Host usage). Prefer the read-only Coolify
# stats token — never COOLIFY_AGENTS. Defaults target the fleet Hetzner host.
# HCLOUD_TOKEN="..."   # or HETZNER_API_TOKEN
# HETZNER_SERVER_ID="159792099"
# COOLIFY_SERVER_STATS="..."
# COOLIFY_HOST="https://host.jays.services"
# COOLIFY_SERVER_UUID="jxzqcs3h6g1wiipnnblhismp"
# COOLIFY_APP_UUID="yagelvqux9e8l1kztif7bf2o"

# Shared password that gates access to the dashboard and its API routes (see /login)
DASHBOARD_PASSWORD="change-me-to-a-random-secret"

# Secret used to sign session cookies via HKDF
SESSION_SECRET="change-me-to-a-session-secret"

# Optional: enables the read-only Sentry Health dashboard card
# (GET /api/sentry-health). Absent by default -> card renders nothing.
# SENTRY_READ_TOKEN must be an org-auth-token (or internal integration token)
# with "project:read" / "event:read" scope. Never sent to the client.
# SENTRY_READ_TOKEN="change-me"
# SENTRY_ORG="simple-with-us"
# Slug of THIS app's own Sentry project, shown first on the health card.
# SENTRY_SELF_PROJECT="usage-monitor"

# Optional: self error-reporting — this app captures its OWN errors to Sentry
# (review finding O4). Fully OFF unless a DSN is set; with no DSN the SDK is
# never initialized and builds/boots are completely unaffected (CI/dev need
# none of these). Server + edge (middleware) capture uses SENTRY_DSN at
# runtime (Infisical inject is enough). Browser capture needs the public twin
# because only NEXT_PUBLIC_* vars are inlined into the client bundle — set
# NEXT_PUBLIC_SENTRY_DSN as a Coolify *build-time* env (Dockerfile ARG) or
# the production client stays dark. Same project DSN as SENTRY_DSN; it is a
# public client DSN. Never commit a real DSN.
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# Performance tracing sample rate 0..1. Defaults to 0.2 (20% baseline distributed tracing).
# SENTRY_TRACES_SAMPLE_RATE="0.2"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.2"
# Optional: enables readable stack traces via sourcemap upload at build time.
# Without it, the build skips sourcemap upload silently (never fails).
# SENTRY_AUTH_TOKEN="sntryu_..."

# Datadog (existing fleet account, US5).  Reuse these names — do not invent
# new secret keys in git.  Production runtime fails closed without DD_SERVICE.
# The host agent already holds DD_API_KEY; this app talks to that agent.
# RUM stays dark until the existing public application id + client token
# are set (the org does not already have RUM enabled — do not buy it here).
# DD_SERVICE="usage-monitor"
# DD_ENV="prod"
# DD_SITE="us5.datadoghq.com"
# DD_AGENT_HOST="127.0.0.1"
# DD_TRACE_AGENT_PORT="8126"
# DD_TRACE_SAMPLE_RATE="0.2"
# DD_VERSION=""  # falls back to SOURCE_COMMIT / GIT_COMMIT_SHA
# Throwaway containers only:
# DD_TRACE_ENABLED="false"
# Public RUM / browser-log twins (optional; incomplete pair fails closed):
# NEXT_PUBLIC_DD_APPLICATION_ID=""
# NEXT_PUBLIC_DD_CLIENT_TOKEN=""
# NEXT_PUBLIC_DD_SITE="us5.datadoghq.com"
# NEXT_PUBLIC_DD_SERVICE="usage-monitor"
# NEXT_PUBLIC_DD_ENV="prod"

# Optional: rotate a fixed, monitor-functional allowlist of Provider
# credentials from SocraticTrade.com, Congress.Trade, and shared Infisical
# scopes before the immediate startup poll and every scheduled poll. Shared
# secrets are fallback-only when an app-scoped value is definitely absent.
# Existing encrypted credentials remain last-known-good after any failed read.
# INFISICAL_PROVIDER_SYNC_ENABLED="true"
# INFISICAL_BASE_URL="https://app.infisical.com"
# INFISICAL_ENV="prod"
# INFISICAL_AUTOMATION_CLIENT_ID="..."
# INFISICAL_AUTOMATION_CLIENT_SECRET="..."
# INFISICAL_ST_CLIENT_ID="..."
# INFISICAL_ST_CLIENT_SECRET="..."
# INFISICAL_CT_CLIENT_ID="..."
# INFISICAL_CT_CLIENT_SECRET="..."
# INFISICAL_SHARED_CLIENT_ID="..."
# INFISICAL_SHARED_CLIENT_SECRET="..."
# INFISICAL_UM_CLIENT_ID="..."
# INFISICAL_UM_CLIENT_SECRET="..."
# The project IDs and `/` secret paths have verified defaults. Optional:
# INFISICAL_ST_PROJECT_ID="39d93bb7-76f9-498c-8b50-a7def52e072f"
# INFISICAL_CT_PROJECT_ID="f61a79de-8d77-4f0b-9361-4b7208598290"
# INFISICAL_SHARED_PROJECT_ID="18f563a3-9c88-454c-96eb-28fc9678f3ba"
# INFISICAL_UM_PROJECT_ID="86e35e51-91bc-4dfd-a045-4484726b9c40"
# INFISICAL_ST_SECRET_PATH="/"
# INFISICAL_CT_SECRET_PATH="/"
# INFISICAL_SHARED_SECRET_PATH="/"
# INFISICAL_UM_SECRET_PATH="/"

# Optional isolated reader for the SocraticTrade.com primary user account.
# Defaults off and uses its own read-only identity at the fixed ST Infisical
# prod path `/usage-monitor/st-primary/v1`; project/path overrides are ignored.
# It accepts only strict BRIDGE_MANIFEST_V1 complete sets for GEMINI_API_KEY and
# DEEPSEEK_API_KEY. Do not reuse an app-root writer identity here.
# INFISICAL_ST_PRIMARY_SYNC_ENABLED="false"
# INFISICAL_ST_PRIMARY_CLIENT_ID="..."
# INFISICAL_ST_PRIMARY_CLIENT_SECRET="..."

# One-time emergency bootstrap only. Defaults off. When explicitly true, the
# server may create the fixed ST prod `/` shared GEMINI_API_KEY from the exact
# current SocraticTrade.com Google AI provider after strict validation. It can
# never update or delete an Infisical value. Disable immediately after one run.
# INFISICAL_ST_GEMINI_BOOTSTRAP_ENABLED="false"

# Default-off exact handoff for the one previously owner-entered Cloudflare
# Workers subscription. Set only to the reviewed canonical Subscription UUID.
# Maintenance requires exact provider identity, current authoritative terms,
# and the deterministic already-materialized charge before changing only its
# management flag, charge guard, and auto-renew behavior in place.
# CLOUDFLARE_LEGACY_HANDOFF_SUBSCRIPTION_ID=""

# Optional: deliver provider budget/balance/stale alerts outside the dashboard.
# At least one channel must be set before outbound alert delivery sends anything.
# ALERT_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
# ALERT_WEBHOOK_URL="https://example.com/internal/provider-alerts"
# ALERT_RESEND_API_KEY="re_..."
# ALERT_EMAIL_FROM="alerts@example.com"
# ALERT_EMAIL_TO="oncall@example.com"
# ALERT_PAGERDUTY_ROUTING_KEY="..."
# Native iOS push (HTTP/2 to APNs). Same channel as Pushover/email — budget and
# provider alerts fan out to every active row in ApnsDeviceToken. Never commit a
# real .p8. Verify Infisical writes by key presence + value length only.
# APNS_KEY_ID="10CHARKEY1"
# APNS_TEAM_ID="CC8UTF7ATG"
# APNS_BUNDLE_ID="com.simplewithus.usage.client"
# APNS_P8="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# APNS_PRIVATE_KEY_B64 is accepted as an alias for a base64-encoded .p8.
# ALERT_MIN_SEVERITY="warning" # info | warning | critical
# ALERT_REMINDER_HOURS="24"
# Each channel HTTP attempt is time-bounded and retries only transient failures.
# ALERT_DELIVERY_TIMEOUT_MS="10000" # max 60000
# ALERT_DELIVERY_MAX_ATTEMPTS="3"   # includes first attempt; max 5
# ALERT_DELIVERY_RETRY_BASE_MS="250" # exponential waits, each capped at 5000ms
#
# Per-alert-code fatigue controls (no schema changes; unknown codes/values are
# dropped with a warning). Severity overrides apply to both the persisted
# incident and delivery eligibility:
# ALERT_CODE_SEVERITY_OVERRIDES='{"stale_snapshot":"info"}'
# Channel routing narrows which configured channels may TRIGGER a code (an open
# incident still resolves on the channel it triggered on; [] suppresses
# external delivery for that code entirely):
# ALERT_CODE_CHANNEL_ROUTING='{"budget_exceeded":["slack","pagerduty"],"stale_snapshot":[]}'
#
# Per-project budget/spend alerts (project_budget_warning /
# project_budget_exceeded / project_spend_anomaly / unassigned_spend), carried
# on the inactive "project-budgets" system provider row through the standard
# incident machinery. Default on; set false to disable (open incidents then
# resolve and no new ones are created).
# ALERT_PROJECT_BUDGETS_ENABLED="true"
# Info alert when month-to-date spend is not attributed to any configured
# project above this floor (only evaluated once at least one project exists).
# ALERT_UNASSIGNED_SPEND_FLOOR_USD="25"
#
# Subscription & billing insight alerts (unused_subscription /
# possible_duplicate_subscription / price_change_detected), all info severity.
# Note: with the default ALERT_MIN_SEVERITY="warning", info alerts are counted
# but not delivered externally — set ALERT_MIN_SEVERITY="info" or a per-code
# severity override to receive them.
# ALERT_SUBSCRIPTION_INSIGHTS_ENABLED="true"

# Optional: raw-row retention before daily rollup + pruning.
# External events are never pruned from the current UTC month, even if this is lower.
# USAGE_SNAPSHOT_RAW_RETENTION_DAYS="45"
# USAGE_SNAPSHOT_RAW_DATA_RETENTION_DAYS="14"
# EXTERNAL_USAGE_EVENT_RAW_RETENTION_DAYS="90"
# Legacy compatibility setting only. Rolled-up idempotency tombstones are now
# retained permanently so a late producer retry cannot be counted twice.
# EXTERNAL_USAGE_EVENT_TOMBSTONE_RETENTION_DAYS="180"

# Optional: how long computeBudgetStatus's stale-while-revalidate cache serves
# a value before kicking off a background refresh (GET /api/providers,
# /api/projects, /api/budget-status all read through it). A request never
# blocks on the refresh - it always gets the last good value immediately.
# BUDGET_STATUS_CACHE_TTL_MS="60000"

# GROK3-E19: Optional verified-preferred cash mode for OpenRouter.
# When true/1/yes, budget-status uses OpenRouter's authoritative period-level
# verified cost (from the reconciliation layer) instead of the self-reported
# max(snapshot, pushed) variable-usage estimate — but ONLY when per-event
# verification coverage is >= the threshold below AND a period-level verified
# figure is available. Default OFF; never touches non-OpenRouter providers.
# OPENROUTER_VERIFIED_PREFERRED_CASH="true"
# Minimum verification coverage fraction (0..1) required before the verified
# total is substituted. Default 0.9 (90% of events must have settled).
# OPENROUTER_VERIFIED_PREFERRED_MIN_COVERAGE="0.9"

# OpenRouter public money probe (GET /api/openrouter-credits) for UptimeRobot.
# Prefer a Management key so account /credits + every key's limit_remaining are readable.
# OPENROUTER_MANAGEMENT_KEY=
# OPENROUTER_ADMIN_KEY=
# Alert when account remaining < this USD floor (default 3).
# OPENROUTER_LOW_CREDIT_USD=3
# Alert when any enabled key's limit_remaining is under this USD floor (default 3; 0 = only exhausted).
# OPENROUTER_KEY_LIMIT_LOW_USD=3
# Cache TTL for the probe (ms; min 30000). Default 10 min.
# OPENROUTER_CREDIT_CHECK_INTERVAL_MS=600000


# Full SQLite VACUUM is intentionally disabled in scheduled retention because
# it takes an exclusive lock and rewrites the entire database. Enable only for
# a deliberate maintenance window; the legacy disable flag still overrides it.
# DATA_RETENTION_ENABLE_VACUUM="false"
# DATA_RETENTION_DISABLE_VACUUM="false"

# Optional: hard ceiling for durable cumulative-OTLP series checkpoints.
# Checkpoints are not time-pruned because deleting one can replay a producer's
# full cumulative counter. New series fail with 503 once this safe bound is hit.
# OTLP_MAX_CUMULATIVE_SERIES="100000"

# Emergency receiver isolation for database-writing OTLP metrics. Defaults on.
# Set false / 0 / off / no to reject authenticated metric exports before body
# decoding or SQLite access with 503 + Retry-After; excess IP-limited requests
# receive 429 with the same long backoff. Generic /api/ingest/usage stays enabled.
# Re-enable only after database health and a controlled OTLP ingest are proven.
# OTLP_METRICS_INGEST_ENABLED="true"

# Opt-in persistence for OTLP system.* host metrics (CPU/memory/disk/network).
# Defaults OFF — when unset, those points are accepted and dropped so host
# gauges cannot flood ExternalUsageEvent or mis-label spend under "hetzner".
# Set true / 1 / on / yes only if you intentionally want host metrics stored.
# OTLP_SYSTEM_METRICS_INGEST_ENABLED="false"

# Optional scheduler readiness tuning. One transient failed tick stays ready;
# repeated failures, a stalled tick, or a stale completed tick fail readiness.
# SCHEDULER_FAILURE_THRESHOLD="3"
# SCHEDULER_STALE_AFTER_MS="2700000"

# Emergency isolation switch for the in-process provider polling scheduler.
# Defaults on. Set false only while diagnosing scheduler/SQLite contention;
# pushed usage ingest remains available, but provider snapshots stop refreshing.
# Re-enable only after a successful provider tick and DB-backed smoke proof.
# USAGE_SCHEDULER_ENABLED="true"

# Startup-wrapper readiness: in production (NODE_ENV=production, or whenever
# LITESTREAM_REQUIRED=true) /api/ready fails strict readiness unless the
# process booted through scripts/start-with-litestream.sh (verified
# pre-migration backup + safe migration + Litestream). Set false ONLY for
# disposable throwaway containers that never write to SQLite.
# STARTUP_WRAPPER_REQUIRED="true"

# Optional: free-bytes warn threshold for the observability-only checks.disk
# block in /api/ready (never gates `ok`). Defaults to 5 GiB, aligned with the
# deploy preflight's MIN_DATA_FREE_BYTES in deploy/oracle/deploy-production.sh.
# READY_DISK_WARN_FREE_BYTES="5368709120"

# Optional: per-request timeout (ms) for poll-adapter HTTP calls (src/lib/adapters/helpers.ts's
# fetchJson). Defaults to 30000. Invalid/non-positive values fall back to the default.
# ADAPTER_HTTP_TIMEOUT_MS="30000"

# Optional: outer per-provider time budget (ms) for fetchAllDueProviders (src/lib/usage-recorder.ts).
# Bounds how long one provider's fetch can stall the sequential poll loop before it's counted as a
# failure and the loop moves on. Defaults to 90000. Invalid/non-positive values fall back to the default.
# ADAPTER_PROVIDER_TIMEOUT_MS="90000"

# Optional (default-off): ingest-time LiteLLM cost derivation for generic pushed
# telemetry (src/lib/pricing/derive-ingest-cost.ts). When enabled, unpriced
# metricType="usage"/unit="token" events whose keyRef resolves in the bundled
# pricing snapshot (src/lib/pricing/model-pricing.snapshot.json, refresh via
# `npm run pricing:update`) get a monitor-computed estimate stamped into
# METADATA only (`_derivedCostUsd` + provenance keys) — `costUsd` stays null, so
# pushed-cash budgets and priced/unpriced coverage counts are untouched. The
# estimate total surfaces separately in GET /api/usage-events and the dashboard
# telemetry panel as "Monitor-estimated". Enable also turns on one bounded
# json_extract aggregate scan per summary compute.
# INGEST_COST_DERIVATION_ENABLED="true"

# Optional: continuous Litestream replication of /data/prod.db to Backblaze B2
# (production primary, 2026-08-07). Cloudflare R2 is historic freeze only — do
# not delete R2 until B2 restore is proven. Garage is retired. Set all four of
# BUCKET/ENDPOINT/ACCESS_KEY_ID/SECRET_ACCESS_KEY together. See docs/litestream.md.
# LITESTREAM_S3_BUCKET="jays-usage-monitor-eu"
# LITESTREAM_S3_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
# LITESTREAM_S3_ACCESS_KEY_ID="change-me"   # B2 write key (fleet-usage-monitor-backup)
# LITESTREAM_S3_SECRET_ACCESS_KEY="change-me"
# LITESTREAM_S3_REGION="eu-central-003"
# LITESTREAM_REQUIRED="false" # set true in production after a successful restore drill
#
# R2 free-tier monitor (src/lib/r2-usage.ts): still watches historic R2 usage
# and may set /data/r2-disabled-70pct.flag — that kill switch only stops
# litestream when the endpoint is R2, not when on B2.
# R2_USAGE_ACCOUNT_ID="<cloudflare-account-id>"
# R2_USAGE_API_TOKEN="<token-with-account-analytics-read>"
# (fallbacks: CLOUDFLARE_JAY_ACCOUNT_ID / CLOUDFLARE_JAY_API_TOKEN, or
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN)
#
# Fleet Ops card (UM dashboard): optional ST + CT pairs so all three free tiers
# show side-by-side. Kill-switch still only uses the Jay/UM account above.
# CLOUDFLARE_ST_ACCOUNT_ID="..."
# CLOUDFLARE_ST_API_TOKEN="..."   # Account Analytics Read
# CLOUDFLARE_CT_ACCOUNT_ID="..."
# CLOUDFLARE_CT_API_TOKEN="..."
# PUSHOVER_USER_KEY="..."
# PUSHOVER_USAGE_API_TOKEN="..."   # subject logo for Usage Monitor free-tier alerts
# Optional peer logos if this host ever pushes about ST/CT free tiers:
# PUSHOVER_ST_API_TOKEN="..."
# PUSHOVER_CT_API_TOKEN="..."
# Messages always append "(sent from Usage Monitor)". Daily digests should stay
# on a staggered UTC hour vs ST (14) / CT (20) — UM prefers morning (~08Z) via
# maintenance tick once-per-day watermark (first successful send wins).
# Manual break-glass (same flag path as auto-disable):
# LITESTREAM_EMERGENCY_DISABLE="true"
# R2_WRITES_DISABLED="true"

# Backblaze B2 (Usage Monitor inventory / storage estimate)
# Prefer a dedicated read-only application key (listBuckets + listFiles), e.g.
# fleet-usage-monitor-readonly from ~/.secrets/backblaze-monitor.env — not write backup keys.
# BACKBLAZE_APPLICATION_KEY_ID=
# BACKBLAZE_APPLICATION_KEY=
# Optional soft cap + catalog overrides (also settable on the provider config):
# BACKBLAZE_STORAGE_CAP_GB=50
# BACKBLAZE_STORAGE_PRICE_PER_GB=0.006

# ===========================================================================
# Platform status probes (GET /api/platform-status → Platforms page)
# ===========================================================================
# One read-only card per external platform, implemented in
# src/lib/platform-status/probes/.  Nothing below is required.  A platform with
# no credentials renders as "Not configured" and prints its var names on the
# card, which is the most common reason a card silently stays blank.
# Where several names are listed for one platform, the probe uses the FIRST
# one that is set and ignores the rest.  Every probe only reads, so prefer the
# narrowest read-only/monitor token each vendor offers.

# --- Hosting & Compute ---
# Hetzner and Coolify reuse the vars documented above in the "Hetzner +
# Coolify host metrics" block, so wiring host metrics wires these cards too.
# Hetzner also accepts HETZNER_API_KEY after HCLOUD_TOKEN and
# HETZNER_API_TOKEN; Coolify also accepts COOLIFY_API_TOKEN after
# COOLIFY_SERVER_STATS.  Keep Coolify on the read-only COOLIFY_SERVER_STATS
# token — never COOLIFY_AGENTS, which can deploy and restart applications.
# COOLIFY_HOST must be an HTTPS URL or the card reports it as invalid.
# Cards show the Hetzner server name, status, type, location and backup
# window, and the Coolify application count split by running, unhealthy,
# unknown health, and stopped.

# Render: service count with a live/suspended split, and the name of anything
# suspended.  A read-only API key is enough.
# RENDER_API_KEY="..."   # or RENDER_API_TOKEN

# Vercel: project count plus production-ready, failed, and building counts.
# A read-only access token is enough.  Without VERCEL_TEAM_ID only the token
# owner's personal scope is listed, so set it for team projects.
# VERCEL_API_TOKEN="..."   # or VERCEL_TOKEN
# VERCEL_TEAM_ID="team_..."

# Netlify: site count plus published and failed-build counts.
# A personal access token with read access is enough.
# NETLIFY_API_TOKEN="..."

# Fly.io: app count, total machines, and the organization the card covers.
# A read-only org token is enough.  FLY_ORG_SLUG defaults to "personal", so
# set it whenever the apps live under a named organization.
# FLY_API_TOKEN="..."
# FLY_ORG_SLUG="personal"

# Railway: project and service counts.  This must be an ACCOUNT token — the
# probe runs the GraphQL `me` query, which a project-scoped token cannot read.
# RAILWAY_API_TOKEN="..."

# DigitalOcean: droplet count with an active/not-active split.  A read-scoped
# personal access token is enough; write scope is never used.
# DIGITALOCEAN_API_TOKEN="..."

# --- Edge & Network ---
# Cloudflare reuses the R2 fleet account pairs documented above
# (R2_USAGE_* with the CLOUDFLARE_JAY_* / CLOUDFLARE_ACCOUNT_ID fallbacks,
# plus CLOUDFLARE_ST_* and CLOUDFLARE_CT_*).  The card verifies each account's
# token and shows per-account status, zone count, and the earliest token
# expiry, so a silently revoked or expired token surfaces before a backup or
# DNS change fails.  Zone count additionally needs Zone Read; an
# Account-Analytics-only token still verifies and simply shows no zones.

# --- Storage & Backups ---
# Backblaze B2 and Cloudflare R2 reuse the vars documented above.  B2 also
# accepts B2_MONITOR_KEY_ID / BACKBLAZE_KEY_ID / B2_KEY_ID for the key id and
# B2_MONITOR_APPLICATION_KEY / B2_APPLICATION_KEY for the key.  Use the
# read-only monitor key that holds listBuckets + listFiles — never a write
# backup key.  The B2 card shows bucket count, key scope, whether the key may
# list files, and the account id suffix; the R2 card shows each account's
# free-tier usage and the free-tier guard state.

# --- Observability ---
# Sentry reuses SENTRY_READ_TOKEN and SENTRY_ORG documented above; the card
# renders the same per-project unresolved issue counts as the dashboard.

# UptimeRobot: monitor count, up/down/paused split, the names of anything
# down, and the 30-day average uptime.  A read-only API key is enough.  This is
# the same account that polls the public /api/openrouter-credits money probe,
# so a down monitor here can mean the credit probe went dark.
# UPTIMEROBOT_API_KEY="..."

# PagerDuty: triggered, acknowledged, and high-urgency open incident counts
# plus the age of the oldest triggered one.  Use a read-only General Access
# REST API key.  This is NOT ALERT_PAGERDUTY_ROUTING_KEY above — that one is
# an Events API routing key used to SEND alerts, and it cannot read incidents.
# PAGERDUTY_API_KEY="..."

# --- Developer & Release ---
# GitHub: core and GraphQL rate-limit headroom plus the newest Actions run for
# this repo.  A read-only token is enough.  Actions read is optional — without
# it the card keeps the rate-limit half and says runs are not readable.
# GITHUB_TOKEN="..."   # or GITHUB_API_TOKEN / GITHUB_PAT

# App Store Connect: newest build version, Apple's processing state, builds
# still processing, and build expiry.  A key with App Manager or Developer
# read access is enough.
# ASC_PRIVATE_KEY must hold the CONTENTS of the downloaded .p8 PEM, not a
# path to it — production runs in a container where that file does not exist.
# It must be the EC P-256 key App Store Connect issues.  Literal \n escapes
# are accepted so the PEM survives single-line env storage, and a bare base64
# body with no PEM header is wrapped automatically.
# ASC_ISSUER_ID="..."
# ASC_KEY_ID="..."
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Messaging & Delivery ---
# Twilio: account status, account type, and prepaid balance.  Both vars must be
# set or the card reports incomplete credentials.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."

# SendGrid: credits remaining, monthly allowance, overage, and next reset.
# A restricted key with Credits read is enough; no mail is ever sent.
# SENDGRID_API_KEY="SG...."

# Resend: sending-domain count and how many are verified, because an
# unverified domain is a real delivery outage even when every request is 200.
# The key only needs to list domains.  This is NOT ALERT_RESEND_API_KEY above,
# which is the key used to send alert email.
# RESEND_API_KEY="re_..."

# Slack: workspace name, workspace id, and bot identity via auth.test, which
# needs no scope beyond a valid bot token.  This is NOT
# ALERT_SLACK_WEBHOOK_URL above, which posts alerts to one channel.
# SLACK_BOT_TOKEN="xoxb-..."

# Pushover reuses PUSHOVER_USER_KEY and the per-app PUSHOVER_*_API_TOKEN vars
# documented above; Usage Monitor also accepts PUSHOVER_UM_API_TOKEN,
# PUSHOVER_API_TOKEN, and PUSHOVER_APP_TOKEN.  The card shows each app's
# remaining monthly quota, the UTC reset day, and whether the user key is set
# — application tokens alone cannot deliver an alert without it.

# --- Payments ---
# Stripe: key mode (live or test), whether charges and payouts are enabled,
# onboarding state, and outstanding requirements.  No balances or revenue.
# Use a RESTRICTED read key (rk_live_...) with Account read — never a full
# sk_live_ secret key, which grants write access this card never needs.
# A test key detected while NODE_ENV=production degrades the card on purpose,
# because real money silently not moving is worse than a loud failure.
# STRIPE_SECRET_KEY="rk_live_..."   # legacy alias: STRIPE_API_KEY

# --- Secrets ---
# Infisical reuses the INFISICAL_* machine identities documented above.  The
# card proves each identity can still log in and still sees secrets, since a
# dead identity stops provider credential rotation without crashing anything.
# It lists secret NAMES only (viewSecretValue=false), so no secret value ever
# reaches this process.  INFISICAL_BASE_URL must stay on app., us., or
# eu.infisical.com or the card refuses to probe.
# ===========================================================================
