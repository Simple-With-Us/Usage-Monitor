[Unit]
Description=Periodically refresh the Litestream replica heartbeat for /api/ready

[Timer]
# Thirty-minute cadence (widened 2026-08-31 from 10min, alongside trimming
# the probe from 5 to 2 litestream ltx LIST calls per tick, to cut Backblaze
# Class C usage) still keeps well inside the three-hour
# LITESTREAM_REPLICA_MAX_AGE_SECONDS staleness budget (aligned with the 1h
# Litestream sync-interval), so several consecutive missed probes are needed
# before the side-channel ages out — a single slow listing never pages anyone.
# OnUnitActiveSec (not OnUnitInactiveSec) so the interval is measured from
# each run's start, independent of how long a given run takes.
OnBootSec=2min
OnUnitActiveSec=30min
RandomizedDelaySec=30s
AccuracySec=10s
Persistent=true
Unit=usage-monitor-replica-status.service

[Install]
WantedBy=timers.target
