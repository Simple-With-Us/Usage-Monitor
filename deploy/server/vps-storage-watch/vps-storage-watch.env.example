# Copy to /etc/vps-storage-watch.env on the server (root, mode 0600) and fill in the real paths.
# The paths are host inventory, so the real file never goes in this repo.
ST_APP_DB=/var/lib/docker/volumes/<socratic-trade-volume>/_data/app.db
CT_DB=/data/congress-trade/db.sqlite
UM_DB=/var/lib/docker/volumes/<usage-monitor-volume>/_data/prod.db
