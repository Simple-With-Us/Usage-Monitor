# Bootstrap-only credentials for the Usage Monitor host.
# Install as root-owned mode 0600:
#   /etc/usage-monitor/infisical-bootstrap.env
#
# These are the ONLY long-lived secrets that must live on the host so the
# machine can talk to Infisical. All application secrets (encryption key,
# ingest tokens, Litestream, dashboard password, etc.) live in Infisical
# project usage-monitor (prod /) and are materialized by:
#   /usr/local/sbin/usage-monitor-sync-env
#
# Never put ENCRYPTION_KEY, USAGE_INGEST_TOKEN, SESSION_SECRET, or Litestream
# credentials in this file.

INFISICAL_BASE_URL=https://app.infisical.com
INFISICAL_ENV=prod
INFISICAL_UM_PROJECT_ID=<INFISICAL_UM_PROJECT_ID>
INFISICAL_PROJECT_ID=<INFISICAL_UM_PROJECT_ID>
INFISICAL_AUTOMATION_CLIENT_ID=replace-me
INFISICAL_AUTOMATION_CLIENT_SECRET=replace-me
