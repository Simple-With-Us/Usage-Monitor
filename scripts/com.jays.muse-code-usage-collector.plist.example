<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template launchd job for scripts/muse-code-usage-collector.mjs

  Reports Meta Muse Code percent REMAINING for the 5h rolling window and the
  weekly window.  The collector receives MUSE_CODE_ACCESS_TOKEN through the
  approved scoped Usage Monitor secret-injection route.  It does not read Meta
  credentials from Keychain.  Do not put secret values in this plist.  When the
  approved injection route is unavailable, the collector exits successfully
  without posting an empty batch or clearing prior readings.

  This prevention template intentionally contains no secret bootstrap.  A direct
  installation stops Keychain prompts but does not refresh Muse quota until the
  approved service-token or explicit app machine-identity entrypoint wraps these
  ProgramArguments.  Do not substitute a shared or Automation identity.

  Replace /ABSOLUTE/PATH/TO/HOME below with the owner's home directory.

  Install:
    cp scripts/com.jays.muse-code-usage-collector.plist.example \
       ~/Library/LaunchAgents/com.jays.muse-code-usage-collector.plist
    # replace every /ABSOLUTE/PATH placeholder below, then:
    launchctl bootstrap gui/$(id -u) \
       ~/Library/LaunchAgents/com.jays.muse-code-usage-collector.plist
    launchctl kickstart -k gui/$(id -u)/com.jays.muse-code-usage-collector

  Dry run first through the approved secret-injection route (prints numbers,
  window labels and ISO dates only):
    node scripts/muse-code-usage-collector.mjs --dry-run

  StartInterval 900 = 15 minutes, matching subscription-quota-collector.

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jays.muse-code-usage-collector
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jays.muse-code-usage-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/Usage-Monitor/scripts/muse-code-usage-collector.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/muse-code-usage-collector.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/muse-code-usage-collector.log</string>
</dict>
</plist>
