<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template launchd job for the Meta Muse Code quota collector

  The collector expects MUSE_CODE_ACCESS_TOKEN and MUSE_CODE_INGEST_TOKEN in its process
  environment.  Supply them from the approved Usage Monitor Infisical binding through the
  authorized launch environment.  Do not place secret values in this plist; replace
  /ABSOLUTE/PATH placeholders before installation

  Install:
    cp scripts/com.jays.muse-code-usage-collector.plist.example \
       ~/Library/LaunchAgents/com.jays.muse-code-usage-collector.plist
    launchctl bootstrap gui/$(id -u) \
       ~/Library/LaunchAgents/com.jays.muse-code-usage-collector.plist
    launchctl kickstart -k gui/$(id -u)/com.jays.muse-code-usage-collector

  Dry run first (prints numbers, window labels and ISO dates only):
    Run the collector with its dry-run option after Infisical injects the environment

  StartInterval 900 = 15 minutes, matching subscription-quota-collector

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jays.muse-code-usage-collector
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jays.muse-code-usage-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/usage-monitor-collectors/scripts/muse-code-usage-collector.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/muse-code-usage-collector.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/muse-code-usage-collector.log</string>
</dict>
</plist>