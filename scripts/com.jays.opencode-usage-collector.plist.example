<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template launchd job for scripts/opencode-usage-collector.mjs.

  Must run on the Mac that has ~/.local/share/opencode/opencode.db.  The
  database is opened read-only, so opencode can keep running.  Needs Node 24
  (node:sqlite).

  Run it from the installed collector copy, never from ~/Code:
    scripts/install-collectors.sh        (see docs/runbooks/mac-collectors-install.md)

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jays.opencode-usage-collector
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jays.opencode-usage-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@24/bin/node</string>
    <string>/ABSOLUTE/PATH/TO/HOME/apps/usage-monitor-collectors/scripts/opencode-usage-collector.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/opencode-usage-collector.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/opencode-usage-collector.log</string>
</dict>
</plist>
