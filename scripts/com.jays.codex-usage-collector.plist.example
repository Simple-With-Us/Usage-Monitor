<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template launchd job for scripts/codex-usage-collector.mjs.

  Must run on the Mac that has ~/.codex/sessions.  Install like the
  Antigravity collector: copy to ~/Library/LaunchAgents, replace
  ABSOLUTE/PATH placeholders, infisical login once, then bootstrap.

  StartInterval 900 = 15 minutes.  The first run defaults to a 180-day
  bootstrap; later runs resume from a durable successful-through watermark
  with a five-minute idempotent overlap.  On-demand: run the node script with
  --dry-run first, or --days 400 to backfill.

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jays.codex-usage-collector
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jays.codex-usage-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/Usage-Monitor/scripts/codex-usage-collector.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/codex-usage-collector.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/HOME/Library/Logs/codex-usage-collector.log</string>
</dict>
</plist>
